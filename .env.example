MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/dpm_custom_prints?retryWrites=true&w=majority
AUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000
ADMIN_EMAIL=admin@dpmprints.local
ADMIN_PASSWORD=replace-this-before-production
NEXT_PUBLIC_SITE_URL=http://localhost:3000
UPLOAD_DIR=./uploads
# Moneris payments (Canada)
MONERIS_STORE_ID=
MONERIS_API_TOKEN=
MONERIS_CHECKOUT_ID=
# qa for test credentials, prod for live
MONERIS_ENVIRONMENT=prod
NEXT_PUBLIC_MONERIS_ENVIRONMENT=prod
# Leave false unless Moneris MRC has shipping-address preload enabled (most stores: false)
MONERIS_PRELOAD_ADDRESSES=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Optional: Google Places for checkout address autocomplete (Canada). Without this, OpenStreetMap suggestions are used.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=dpmsuppliesinfo@gmail.com
SMTP_PASSWORD=
SMTP_FROM=DPM Custom Prints <dpmsuppliesinfo@gmail.com>
# Canada Post shipping (Developer Portal REST API, OAuth 2.0). Without these, checkout uses a flat ESTIMATE.
# Developer Portal > Apps > your [Production] app > Credentials: API Key + API Secret (Rating API must be added to the app).
CANADA_POST_API_KEY=
CANADA_POST_API_SECRET=
# 10-digit customer number linked to the app (commercial rates).
CANADA_POST_CUSTOMER_NUMBER=
# Optional: contract ID, and quote type override (commercial or counter).
CANADA_POST_CONTRACT_ID=
CANADA_POST_QUOTE_TYPE=
# Default false: if live rating fails, checkout shows an error. true = charge ESTIMATED rates instead.
CANADA_POST_ALLOW_ESTIMATE_FALLBACK=false
# Ship-from postal code (no spaces), e.g. Peterborough area
COMMERCE_ORIGIN_POSTAL_CODE=K8P3S6
# Optional: AddressComplete for checkout postal autocomplete
CANADA_POST_ADDRESS_COMPLETE_KEY=
ORDER_NOTIFICATION_EMAIL=dpmsuppliesinfo@gmail.com
# Optional customize fees (CAD)
CUSTOMIZE_BASE_FEE_CAD=19
CUSTOMIZE_DESIGN_FEE_CAD=5
